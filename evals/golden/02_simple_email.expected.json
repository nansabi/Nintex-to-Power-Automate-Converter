{
  "name": "Simple Email Notification",
  "definition": {
    "triggers": {
      "manual": {
        "type": "Request",
        "kind": "Button",
        "inputs": {
          "schema": {
            "type": "object",
            "properties": {},
            "required": []
          }
        }
      }
    },
    "actions": {
      "Initialize_variable_RecipientEmail": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "RecipientEmail",
              "type": "String",
              "value": "team@company.com"
            }
          ]
        },
        "runAfter": {}
      },
      "Send_Welcome_Email": {
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "connectionName": "shared_office365",
            "operationId": "SendEmailNotification_V2",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
          },
          "parameters": {
            "emailMessage/To": "@variables('RecipientEmail')",
            "emailMessage/Subject": "Welcome to the Team",
            "emailMessage/Body": "Welcome aboard! We are excited to work with you."
          }
        },
        "runAfter": {
          "Initialize_variable_RecipientEmail": [
            "Succeeded"
          ]
        }
      }
    }
  },
  "needs_manual_review": false,
  "unsupported": [],
  "warnings": [],
  "metrics": {
    "total_actions": 2,
    "converted_count": 2,
    "coverage_percent": 100.0
  }
}

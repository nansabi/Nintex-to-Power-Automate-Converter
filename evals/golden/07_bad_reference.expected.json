          "parameters": {
            "emailMessage/To": "@variables('ValidEmail')",
            "emailMessage/Subject": "System Notification",
            "emailMessage/Body": "The unresolvable variable is {Variable:NonExistentVariable}"
          }
        },
        "runAfter": {
          "Initialize_variable_ValidEmail": [
            "Succeeded"
          ]
        }
      }
    }
  },
  "needs_manual_review": false,
  "unsupported": [],
  "warnings": [
    "Referenced variable 'NonExistentVariable' in '{Variable:NonExistentVariable}' is not declared in workflow variables."
